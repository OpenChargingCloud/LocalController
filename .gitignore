# Build output
bin/
obj/

# The frontend: what npm installs and what webpack emits
node_modules/
LocalController/Frontend/dist/

# The accounts of a running local controller: password hashes and the cookies
# of whoever is signed in, and nobody else's business. Anchored, so that it
# stays this one directory and does not quietly swallow a source folder of the
# same name.
/accounts/

# What the local controller writes down about itself. Which name servers and
# which time server a particular box uses is a property of where it stands,
# not of this repository.
configuration.json
